# AccessShield Mobile Scanner Environment Variables
# Copy this file to .env.local and fill in your values

# Database (same as apps/api)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/accessshield

# Redis (same as apps/api)
REDIS_URL=redis://localhost:6379

# RabbitMQ (same as apps/api)
RABBITMQ_URL=amqp://accessshield:accessshield@localhost:5672

# AWS S3 Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=accessshield-data-dev
CLOUDFRONT_URL=https://cdn.accessshield.in

# BrowserStack App Automate (recommended — no local Android SDK needed)
# If set, mobile scans run on BrowserStack (local APKs are uploaded automatically).
BROWSERSTACK_USERNAME=your-browserstack-username
BROWSERSTACK_ACCESS_KEY=your-browserstack-access-key

# Local Appium only (when BrowserStack is NOT set)
# Install Android Studio, then point to the SDK:
# ANDROID_HOME=/Users/you/Library/Android/sdk
# ANDROID_SDK_ROOT=/Users/you/Library/Android/sdk

# Logging
LOG_LEVEL=info
NODE_ENV=development
